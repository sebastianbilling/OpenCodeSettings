// Personal OpenCode config: C:\Users\<you>\.config\opencode\opencode.jsonc
// Not in Git. If you already have this file from the first setup, add the three new models
// under "models" and keep the rest. There must be only one file there (.json OR .jsonc).
{
  "$schema": "https://opencode.ai/config.json",

  // Offline housekeeping
  "autoupdate": false,
  "share": "disabled",
  "enabled_providers": ["local"],

  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible", // built into OpenCode, nothing to download
      "name": "Local AI servers",
      "options": {
        "baseURL": "<LLM_URL>",
        "apiKey": "{env:LLM_API_KEY}",
        "timeout": 600000
      },
      "models": {
        "<GLM_ID>": {
          "name": "GLM 5.3 Flash",
          "tool_call": true,
          "limit": { "context": 262144, "output": 32768 }
        },
        "<MINIMAX_ID>": {
          "name": "MiniMax 2.5",
          "tool_call": true,
          "limit": { "context": 262144, "output": 32768 }
        },
        "<GEMMA_ID>": {
          "name": "Gemma 4 31B",
          "tool_call": true,
          "limit": { "context": 262144, "output": 32768 }
        },
        "<QWEN_ID>": {
          "name": "Qwen3.5 122B-A10B",
          "tool_call": true,
          "limit": { "context": 262144, "output": 32768 }   // check the real limit with your admin
        },
        "<MISTRAL_ID>": {
          "name": "Mistral Small 3.1",
          "tool_call": true,
          "limit": { "context": 131072, "output": 16384 }   // check the real limit with your admin
        }
      }
    }
  },

  // Defaults. small_model names sessions and does other small jobs; the fastest model is enough.
  "model": "local/<GLM_ID>",
  "small_model": "local/<MISTRAL_ID>"
}
